# Las 4 variables que necesita la app en Vercel (Settings → Environment Variables).
# Sin las 3 primeras, en la PC la app usa datos/almacen.json (solo para pruebas).

# Proyecto Supabase (CODIARD) y su clave pública (publishable). No es secreta.
SUPABASE_URL=https://kvkesiumefziypsxryuf.supabase.co
SUPABASE_ANON_KEY=

# Secreto del sincronizador: protege la escritura en la base de datos y la ruta /api/sync.
# Su hash está guardado en Supabase (privado.secretos); ver supabase/migraciones/002_acceso.sql.
CRON_SECRET=

# Contraseña para entrar al tablero. Sin ella, el tablero queda abierto.
APP_CLAVE=
