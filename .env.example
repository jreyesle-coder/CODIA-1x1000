# Las 4 variables que necesita la app en Vercel (Settings → Environment Variables).
# Si falta cualquiera de las 3 de Supabase, el tablero lo dice en pantalla; en la PC,
# sin ellas, la app usa datos/almacen.json (solo para pruebas).

# Proyecto Supabase (CODIARD) y su clave pública (publishable).
SUPABASE_URL=https://kvkesiumefziypsxryuf.supabase.co
SUPABASE_ANON_KEY=

# Secreto del sincronizador: protege la escritura en la base de datos y la ruta /api/sync,
# y firma las cookies de sesión. Su hash está en Supabase (privado.secretos); ver 002_acceso.sql.
CRON_SECRET=

# Contraseña para entrar al tablero. Use una larga (16+ caracteres). OJO: si falta, el tablero
# queda abierto y no se avisa en pantalla.
APP_CLAVE=
